{"event":"pre-tool-use","timestamp":"2026-10-20T18:36:36.388Z","tool_name":"Bash","tool_input":{"command":"cd 'D:/Dev/senior-full-stack-with-unity-ai-code-challenge/.claude/worktrees/stratus-field-link-exercise-07ba02/unity/StratusFieldLink/Assets/StratusFieldLink' && python - <<'EOF'\np='Runtime/Model/SketchDtos.cs'\ns=open(p).read()\nold=s[s.index('    /// <summary>Shape the API returns on a 4xx.'):s.index('}\\n', s.index('public class ApiErrorDto'))+2]\nnew='''    [Serializable]\n    public class ApiFailureDto\n    {\n        public string field;\n        public string message;\n    }\n\n    /// <summary>Shape the API returns on a 4xx: a summary plus, for a 400, per-field failures.</summary>\n    [Serializable]\n    public class ApiErrorDto\n    {\n        public string error;\n        public List<ApiFailureDto> failures;\n\n        /// <summary>One human-readable line for the foreman. Empty when the body says nothing useful.</summary>\n        public static string Describe(string body)\n        {\n            return string.Empty;\n        }\n    }\n'''\ns=s.replace(old,new)\nopen(p,'w').write(s)\n\np='Runtime/Net/PublishService.cs'\ns=open(p).read()\ns=s.replace('''        public long StatusCode;\n\n        public bool IsSuccess''','''        public long StatusCode;\n\n        /// <summary>True when the server already had this exact sketch (HTTP 200). Still a success.</summary>\n        public bool IsDuplicate;\n\n        public bool IsSuccess''')\nopen(p,'w').write(s)\n\nopen('Tests/EditMode/ApiErrorTests.cs','w').write('''using NUnit.Framework;\nusing StratusFieldLink.Model;\n\nnamespace StratusFieldLink.Tests.EditMode\n{\n    public class ApiErrorTests\n    {\n        [Test]\n        public void Describe_SimpleError_ReturnsTheServerMessage()\n        {\n            Assert.AreEqual(\"Nope.\", ApiErrorDto.Describe(\"{\\\\\"error\\\\\":\\\\\"Nope.\\\\\"}\"));\n        }\n\n        [Test]\n        public void Describe_ValidationFailures_ListsEachFieldMessage()\n        {\n            var body = \"{\\\\\"error\\\\\":\\\\\"Sketch failed validation.\\\\\",\\\\\"failures\\\\\":[\" +\n                       \"{\\\\\"field\\\\\":\\\\\"nodes\\\\\",\\\\\"message\\\\\":\\\\\"A run needs at least two nodes.\\\\\"},\" +\n                       \"{\\\\\"field\\\\\":\\\\\"crewId\\\\\",\\\\\"message\\\\\":\\\\\"Every sketch is attributed to a crew.\\\\\"}]}\";\n\n            var text = ApiErrorDto.Describe(body);\n\n            StringAssert.Contains(\"A run needs at least two nodes.\", text);\n            StringAssert.Contains(\"Every sketch is attributed to a crew.\", text);\n        }\n\n        [TestCase(\"\")]\n        [TestCase(null)]\n        [TestCase(\"<html>502 Bad Gateway</html>\")]\n        public void Describe_NothingUsable_ReturnsEmpty(string body)\n        {\n            Assert.AreEqual(string.Empty, ApiErrorDto.Describe(body));\n        }\n    }\n}\n''')\n\np='Tests/PlayMode/PublishFlowTests.cs'\ns=open(p).read()\nadd='''\n        [UnityTest]\n        public IEnumerator Publish_ServerSaysItAlreadyHasIt_IsSuccessFlaggedAsDuplicate()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(200, \"{\\\\\"id\\\\\":\\\\\"SK-1\\\\\"}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.IsTrue(_publisher.LastResult.IsSuccess);\n            Assert.IsTrue(_publisher.LastResult.IsDuplicate);\n            StringAssert.Contains(\"duplicate\", _publisher.LastResult.Message.ToLowerInvariant());\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_NewSketchAccepted_IsNotFlaggedAsDuplicate()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(201, \"{\\\\\"id\\\\\":\\\\\"SK-1\\\\\"}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.IsFalse(_publisher.LastResult.IsDuplicate);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_ServerRejects400_ReportsRejectedWithTheServersReason()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(400,\n                \"{\\\\\"error\\\\\":\\\\\"Sketch failed validation.\\\\\",\\\\\"failures\\\\\":[{\\\\\"field\\\\\":\\\\\"diameterInches\\\\\",\\\\\"message\\\\\":\\\\\"Diameter must be greater than zero.\\\\\"}]}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.RejectedByServer, _publisher.LastResult.Outcome);\n            Assert.AreEqual(400, _publisher.LastResult.StatusCode);\n            StringAssert.Contains(\"Diameter must be greater than zero.\", _publisher.LastResult.Message);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_ServerSays409_ReportsRejectedWithTheConflictMessage()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(409,\n                \"{\\\\\"error\\\\\":\\\\\"Sketch 'SK-1' was already published with different content.\\\\\"}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.RejectedByServer, _publisher.LastResult.Outcome);\n            Assert.AreEqual(409, _publisher.LastResult.StatusCode);\n            StringAssert.Contains(\"different content\", _publisher.LastResult.Message);\n        }\n'''\nm='        // ---------------------------------------------------------------------\\n        // TODO(candidate): there is no test'\ni=s.index(m)\ns=s[:i]+add.lstrip('\\n')+'\\n'+s[i:]\nopen(p,'w').write(s)\nEOF\ncd ../../.. && S='C:/Users/sohai/AppData/Local/Temp/claude/D--Dev-senior-full-stack-with-unity-ai-code-challenge--claude-worktrees-stratus-field-link-exercise-07ba02/3438e1eb-9007-477a-82ab-5371942d2e0e/scratchpad'\ncd .. && for m in EditMode PlayMode; do unity test StratusFieldLink --editor-version 2022.3.62f1 --mode $m --output \"$S/t1red-$m.xml\" --timeout 900 --no-banner --non-interactive >/dev/null 2>&1; echo \"exit $m: $?\"; grep -o '<test-run[^>]*result=\"[A-Za-z]*\" total=\"[0-9]*\" passed=\"[0-9]*\" failed=\"[0-9]*\"' \"$S/t1red-$m.xml\"; grep -o '<test-case [^>]*result=\"Failed\"' \"$S/t1red-$m.xml\" | grep -o ' name=\"[^\"]*\"'; done","timeout":600000,"description":"Add Unity T1 tests with stubs and run red in both modes"}}
