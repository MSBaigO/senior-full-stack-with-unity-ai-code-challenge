)\n\np='unity/StratusFieldLink/Assets/StratusFieldLink/Tests/PlayMode/PublishFlowTests.cs'\ns=open(p).read()\nadd='''\n        [UnityTest]\n        public IEnumerator Publish_VerticalDrop_IsSentWithItsTrueLength()\n        {\n            var sketch = FieldSketchDto.NewDraft(\"PKG-CHW-L03\", \"CREW-04\");\n            sketch.nodes.Add(new SketchNodeDto(new Vector3(0f, 22f, 0f)));\n            sketch.nodes.Add(new SketchNodeDto(new Vector3(0f, 10f, 0f)));\n\n            yield return _publisher.PublishRoutine(sketch);\n\n            Assert.AreEqual(1, _transport.CallCount, _publisher.LastResult.Message);\n            Assert.AreEqual(12f, sketch.clientLengthFeet, 0.001f);\n        }\n'''\nm='        // ---------------------------------------------------------------------\\n        // TODO(candidate): there is no test'\ni=s.index(m)\ns=s[:i]+add.lstrip('\\n')+'\\n'+s[i:]\nopen(p,'w').write(s)\n\np='src/StratusFieldLink.Api.Tests/RunGeometryTests.cs'\ns=open(p).read()\nadd='''\n    // Parity vectors shared with the Unity client's SketchGeometryTests.\n    [Fact]\n    public void TotalLengthFeet_Diagonal_UsesAllThreeAxes()\n    {\n        var nodes = new List<SketchNode> { N(0, 0, 0), N(3, 4, 12) };\n        Assert.Equal(13d, RunGeometry.TotalLengthFeet(nodes), 6);\n    }\n\n    [Fact]\n    public void TotalLengthFeet_RunWithARiser_SumsHorizontalAndVertical()\n    {\n        var nodes = new List<SketchNode> { N(0, 10, 0), N(30, 10, 0), N(30, 22, 0) };\n        Assert.Equal(42d, RunGeometry.TotalLengthFeet(nodes), 6);\n    }\n\n    [Fact]\n    public void Validate_VerticalDropOffTheHeader_Passes()\n    {\n        var sketch = new FieldSketch\n        {\n            Id = \"SK-DROP\", PackageId = \"PKG-CHW-L03\", CrewId = \"CREW-04\", Discipline = \"Piping\", DiameterInches = 4,\n            Nodes = new List<SketchNode> { N(0, 22, 0), N(0, 10, 0) }\n        };\n        Assert.True(SketchValidator.Validate(sketch).IsValid);\n    }\n'''\ni=s.rindex('}')\ns=s[:i]+add+s[i:]\nopen